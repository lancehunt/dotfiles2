{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(code:*)",
      "Bash(mkdir:*)",
      "Bash(source:*)",
      "Bash(ruff check:*)",
      "Bash(pytest:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude is waiting for your input\" with title \"Claude Code\" sound name \"Glass\"' 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "msg=$(jq -r '.message // \"Claude notification\"' 2>/dev/null || echo 'Claude notification'); osascript -e \"display notification \\\"$msg\\\" with title \\\"Claude Code\\\" sound name \\\"Glass\\\"\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '--- Staged files ---' && git diff --cached --name-only && echo '--- Untracked files ---' && git ls-files --others --exclude-standard"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "atlassian@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "sentry@claude-plugins-official": false,
    "stripe@claude-plugins-official": false,
    "discord@claude-plugins-official": false,
    "imessage@claude-plugins-official": true,
    "pinecone@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "agent-skills@addy-agent-skills": true,
    "ponytail@ponytail": true,
    "data@synced": false,
    "design@synced": false,
    "engineering@synced": false,
    "tools@kit": true,
    "kit@kit": true,
    "domain-driven-design@kit": true
  },
  "extraKnownMarketplaces": {
    "kit": {
      "source": {{ if stat (joinPath .chezmoi.homeDir "code/lancehunt/kit/.claude-plugin/marketplace.json") }}{ "source": "file", "path": "{{ .chezmoi.homeDir }}/code/lancehunt/kit/.claude-plugin/marketplace.json" }{{ else }}{ "source": "github", "repo": "lancehunt/kit" }{{ end }}
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "dietrichgebert/ponytail"
      }
    }
  },
  "effortLevel": "medium",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
